{
  "name": "doudian-master",
  "version": "0.1.0",
  "private": true,
  "description": "抖店后台自动化运营（Node.js + Playwright）",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "smoke": "tsx src/cli.ts -- --feature=chain-smoke",
    "xf:low-goods": "tsx src/cli.ts -- --feature=xf-ali-find-low-goods",
    "ui:server": "tsx src/server/main.ts",
    "ui:dev": "concurrently -k \"npm run ui:server\" \"vite --config web/vite.config.ts\"",
    "ui:build": "vite build --config web/vite.config.ts",
    "ui:start": "npm run build && npm run ui:build && node dist/server/main.js",
    "build": "tsc",
    "test": "npm run build && tsx tests/mcp/scripts/verify-offline.ts",
    "start": "node dist/cli.js",
    "browser:install": "playwright install chromium",
    "codegen": "playwright codegen",
    "sync:feature-docs": "node harness/lib/sync-all-feature-docs.mjs",
    "sync:harness-skill": "node harness/lib/sync-cursor-harness-skill.mjs",
    "sync:hook-docs": "node harness/lib/sync-hook-docs.mjs",
    "setup:hooks": "git config core.hooksPath .githooks",
    "post-commit:run": "node harness/git/run-post-commit.mjs",
    "harness:end": "node harness/cli/end-session.mjs",
    "harness:end:full": "node harness/cli/end-session.mjs --full"
  },
  "dependencies": {
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "lucide-react": "^1.14.0",
    "playwright": "^1.49.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.15.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@playwright/mcp": "^0.0.75",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
