# Agent harness（可选）：团队默认值见 harness/harness.env；个人覆盖见 harness/harness.local.env（gitignore）

# 抖店后台基础地址（按实际环境调整）
DOUDIAN_BASE_URL=https://fxg.jinritemai.com

# 可选：已登录态 storage state 文件路径，存在则启动时自动注入 Cookie
STORAGE_STATE_PATH=.data/storage-state.json

# 可选：headed 模式便于调试（1/true/yes）
PLAYWRIGHT_HEADED=

# --- Chromium：监听导航并自动刷新登录态（npm run dev -- --save-session=watch）---
# 可选：仅当 URL/标题已判定登录后，还要求近期出现过匹配的 XHR/fetch（* 为通配）
# DOUDIAN_FXG_LOGIN_SIGNAL_URL=*ffa*mshop*
# 可选：响应 body 须包含该子串（会读取 response 正文）
# DOUDIAN_FXG_LOGIN_SIGNAL_BODY_SUBSTRING=
# 两次自动保存之间的最短间隔（毫秒，500-600000，默认 3000）
# DOUDIAN_STORAGE_AUTOSAVE_MIN_INTERVAL_MS=

# --- Edge persistent profile 导出登录态（npm run dev -- --save-session=edge）---
# 未设置时默认：.data/edge-profile（推荐，避免占用系统 Edge profile）
# EDGE_USER_DATA_DIR=.data/edge-profile
# 复用本机 Edge 已登录：system 或 auto（须先完全退出 Edge）；多配置可加 EDGE_PROFILE_DIRECTORY=Default
# EDGE_USER_DATA_DIR=system
# EDGE_PROFILE_DIRECTORY=Default
# Edge 模式下等待手动登录并完成工作台断言的最长等待（毫秒，5000-600000，默认 600000）
# DOUDIAN_EDGE_SAVE_SESSION_WAIT_MS=

# --- 邮箱密码自动登录（勿将真实值提交 git；建议仅用本地 .env）---
# DOUDIAN_PASSWORD_LOGIN=1
# DOUDIAN_LOGIN_EMAIL=
# DOUDIAN_LOGIN_PASSWORD=
# login feature：工作台校验通过后写入 STORAGE_STATE_PATH（1/true/yes；密码与仅 storage 场景均生效）
# DOUDIAN_SAVE_SESSION_AFTER_LOGIN=

# 仅单元测试隔离环境变量用；正常使用勿设置
# DOUDIAN_SKIP_REPO_DOTENV=
# 滑块/验证码出现时 headed 下人工完成的最长等待（毫秒，默认 120000）
DOUDIAN_CAPTCHA_MANUAL_TIMEOUT_MS=
# 预留第三方打码标识（首版未实现远程解题）：twocaptcha
DOUDIAN_CAPTCHA_PROVIDER=

# 真网 Feature 验收：用 Cursor + Playwright MCP 按 tests/mcp/features/*.md 执行；实录 .data/mcp-session-records/
