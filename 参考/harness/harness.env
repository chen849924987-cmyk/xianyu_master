# Harness 仓库配置（可提交）
# 优先级：操作系统 / Cursor 已设置的同名变量 > 本文件「仅为未设置的变量」补默认值。
# 个人覆盖：复制本文件为 harness.local.env（已 gitignore），后者覆盖此处默认值。
# 详见 harness/README.md「仓库环境配置」。

# --- AGENT_TASK_PROTOCOL.md ---
HARNESS_SKIP_PROTOCOL_SYNC=0
# HARNESS_SKIP_PROTOCOL_INTENT_SYNC=1
# HARNESS_SKIP_PROTOCOL_USER_INTENT=1
# HARNESS_SKIP_COMMIT_PROTOCOL_LOG=1
# HARNESS_SKIP_COMMIT_PROTOCOL_DETAIL=1
# HARNESS_COMMIT_PROTOCOL_PATCH=1

# --- AGENT_TODOLIST.md ---
# HARNESS_SKIP_TODOLIST_AUTO_ADD=1

# --- 收尾 tier（CLI 也可用 --full）---
HARNESS_HANDOFF_FULL=0

# --- 验证门禁（1=启用）---
HARNESS_REQUIRE_VERIFY=0
HARNESS_AFTER_EDIT_VERIFY=0
# HARNESS_VERIFY_CMD=npm run build
# HARNESS_VERIFY_PATHSPECS=src package.json tsconfig.json
# HARNESS_VERIFY_MAX_AGE_MS=600000

# --- Cursor hooks 调用统计 + Markdown 报告（run-hook 包装器）---
# HARNESS_HOOK_USAGE_TRACK=0
# HARNESS_HOOK_USAGE_MD=0
# HARNESS_HOOK_USAGE_MD_PATH=docs/hook-usage-report.md
# 仅保留 JSON、报告放本地：HARNESS_HOOK_USAGE_MD_PATH=.data/hook-usage-report.md

# --- stop 后自动插入「代码评审」followup（同一对话继续一轮，非独立 Agent 进程）---
# HARNESS_STOP_CODE_REVIEW=1
# HARNESS_STOP_CODE_REVIEW_PATHSPEC=src,package.json,package-lock.json,tsconfig.json,web
# HARNESS_STOP_CODE_REVIEW_ON_STATUS=completed
# 若评审轮被 Cursor 截断：把 .cursor/hooks.json 里 stop 的 loop_limit 调大（例如 5）。

# --- 认知层：挫败时 stop followup ---
HARNESS_AUTO_MODE_SWITCH=0
# HARNESS_FRUSTRATION_WINDOW_MS=1200000
# HARNESS_FRUSTRATION_MIN_HITS=2
# HARNESS_FRUSTRATION_MAX_FOLLOWUPS=1

# --- README：feature 列表自动同步（afterFileEdit）---
# HARNESS_SKIP_README_FEATURES_SYNC=1

# --- Feature 文档 AUTO：tests/mcp/features/<id>.md + src/features/<dir>/README.md（afterFileEdit）---
# HARNESS_SKIP_FEATURE_MCP_DOC_SYNC=1

# --- Cursor Skill：docs/、harness/ → .cursor/skills/harness-session-framework/_synced/（afterFileEdit + npm run sync:harness-skill）---
# HARNESS_SKIP_CURSOR_SKILL_SYNC=1

# --- Hook 文档：harness/hooks → docs/harness/hooks/*.md（afterFileEdit + npm run sync:hook-docs）---
# HARNESS_SKIP_HOOK_DOC_SYNC=1

# --- 防抖 ---
# HARNESS_DEBOUNCE_SHORT_MS=8000
# HARNESS_DEBOUNCE_MS=45000
# HARNESS_AGENT_STOP_DEBOUNCE_MS=12000

# --- commit-msg：拦截 trivial stop-hook 提交（须 npm run setup:hooks）---
# 仅当提交说明为 chore: agent turn handoff (stop hook)、且暂存仅有 HANDOFF.json / AGENT_TASK_PROTOCOL.md、且 churn ≤ 阈值时拒绝
# HARNESS_STOP_HOOK_COMMIT_MAX_CHURN=120
# HARNESS_ALLOW_STOP_HOOK_COMMIT=1

# --- 仅 CLI / 排障 ---
# HARNESS_ROOT=
# HARNESS_CONVERSATION_ID=
# HARNESS_GENERATION_ID=
# HARNESS_FORCE_END=
# HARNESS_FORCE_STOP=
# HARNESS_DEBUG_ENV=
